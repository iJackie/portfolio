'use client';

/**
 * GlobeCanvas — client-only globe.
 *
 *  - Real continent shapes (procedural rectangles in /data/worldMap.ts)
 *  - Dense dot grid so continents read clearly
 *  - Pins:
 *      • active (highlight)   → big rose glow + pulsing ring + label w/ event name
 *      • in-list (next 3)     → medium rose glow + city label
 *      • edge previews (±1)   → small grey dot, no label (scroll-hint only)
 *      • all others           → tiny faint dot
 *  - Events at the SAME city coords are fanned out in a small ring so each
 *    pin has its own position + leader line + label.
 *  - Labels are de-overlapped: clustered labels stack vertically and each
 *    gets a dotted SVG leader line back to its pin.
 *  - Globe glides (no zoom) so the active city faces front.
 */

import { useEffect, useMemo, useRef, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { ChevronLeft, ChevronRight } from 'lucide-react';

import { EVENTS, type EventItem } from '@/data/events';
import { isLand } from '@/data/worldMap';
import AnalyticsRow from './AnalyticsRow';
import AsciiFlower from './AsciiFlower';

type Props = { onSelect: (event: EventItem) => void };

const STAGE = 720;
const GLOBE_R = 280;
const CX = STAGE / 2;
const CY = STAGE / 2;
const STEP_MS = 4200;
const VISIBLE_CARDS = 4;
/** Spatial offset between fanned same-city pins, in projected pixels. */
const FAN_RADIUS = 12;

type Dot = { lat: number; lng: number; isLand: boolean };
type PinLabel = {
  idx: number;
  pinX: number;     // canvas-space x of the pin
  pinY: number;
  labelX: number;   // resolved label box x
  labelY: number;   // resolved label box y
  side: 'left' | 'right';
  z: number;
  tier: 'active' | 'in-list';
  city: string;
  name: string;
};

/**
 * A "cluster" groups multiple PinLabels that share the same city. The card
 * renders the city once with all event names stacked underneath. Leader
 * lines fan out to each pin so the dotted-line story still holds.
 */
type LabelCluster = {
  city: string;
  side: 'left' | 'right';
  /** Anchor (avg of pin positions) for label placement */
  anchorX: number;
  anchorY: number;
  labelX: number;
  labelY: number;
  /** All labels in the cluster (1+). Tier is determined per-event. */
  items: PinLabel[];
  /** Average depth of all pins in the cluster — for opacity */
  z: number;
  /** True if any item in the cluster is the active highlight */
  hasActive: boolean;
};

/**
 * Pre-compute fan offsets AND city centroids per event.
 *
 *   - Group events by CITY (not raw lat/lng) so e.g. Singapore's two events
 *     with slightly different coords still cluster as one Singapore group.
 *   - Each event in a multi-event city renders at the city's centroid plus
 *     a small fan offset, so the pins splay tidily around the city instead
 *     of drifting apart.
 */
const FAN_OFFSETS = (() => {
  const groups = new Map<string, number[]>();
  EVENTS.forEach((e, i) => {
    const k = e.city; // group by city name
    const arr = groups.get(k) ?? [];
    arr.push(i);
    groups.set(k, arr);
  });
  const offsets: { dx: number; dy: number }[] = EVENTS.map(() => ({ dx: 0, dy: 0 }));
  groups.forEach((indices) => {
    if (indices.length === 1) return;
    // Distribute around a tiny circle
    indices.forEach((evIdx, j) => {
      const angle = (j / indices.length) * Math.PI * 2;
      offsets[evIdx] = {
        dx: Math.cos(angle) * FAN_RADIUS,
        dy: Math.sin(angle) * FAN_RADIUS,
      };
    });
  });
  return offsets;
})();

/**
 * Each event's "render position" — its CITY's centroid lat/lng.
 * Using this instead of the event's own coordinates means Singapore's two
 * slightly-offset events both anchor at the same point and only differ by
 * their FAN_OFFSET.
 */
const CITY_LATLNG = (() => {
  const groups = new Map<string, { latSum: number; lngSum: number; n: number }>();
  EVENTS.forEach((e) => {
    const g = groups.get(e.city) ?? { latSum: 0, lngSum: 0, n: 0 };
    g.latSum += e.lat;
    g.lngSum += e.lng;
    g.n += 1;
    groups.set(e.city, g);
  });
  return EVENTS.map((e) => {
    const g = groups.get(e.city)!;
    return { lat: g.latSum / g.n, lng: g.lngSum / g.n };
  });
})();

export default function GlobeCanvas({ onSelect }: Props) {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  /** Tracks the drag start position + the longitude at the moment the user
   *  pressed down, so we can compute a relative drag delta. */
  const dragStartRef = useRef<{ x: number; startLng: number } | null>(null);
  const [highlightIdx, setHighlightIdx] = useState(0);
  const [paused, setPaused] = useState(false);
  const [reducedMotion, setReducedMotion] = useState(false);
  const [clusters, setClusters] = useState<LabelCluster[]>([]);

  const stateRef = useRef<{
    highlightIdx: number;
    paused: boolean;
    visibleSet: Set<number>;
    edgeSet: Set<number>;
    /** Current absolute longitude offset (writable from rAF loop AND drag) */
    lng: number;
    /** True while the user is actively dragging the globe */
    dragging: boolean;
  }>({
    highlightIdx: 0,
    paused: false,
    visibleSet: new Set([0, 1, 2, 3]),
    edgeSet: new Set([EVENTS.length - 1, 4]),
    lng: 0,
    dragging: false,
  });
  useEffect(() => { stateRef.current.highlightIdx = highlightIdx; }, [highlightIdx]);
  useEffect(() => { stateRef.current.paused = paused; }, [paused]);
  useEffect(() => {
    // Visible pins on the globe = every event in the currently-active city.
    // (Previously this was just the next 4 events in the cycle — but the
    // user wants a city click to light up ALL events in that city.)
    const activeCity = EVENTS[highlightIdx].city;
    const inList = new Set<number>();
    EVENTS.forEach((e, i) => {
      if (e.city === activeCity) inList.add(i);
    });
    // Edge previews: the events immediately before / after the city in the
    // cycle, to hint scrollability.
    const edges = new Set<number>([
      (highlightIdx - 1 + EVENTS.length) % EVENTS.length,
      (highlightIdx + 1) % EVENTS.length,
    ]);
    stateRef.current.visibleSet = inList;
    stateRef.current.edgeSet = edges;
  }, [highlightIdx]);

  useEffect(() => {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    setReducedMotion(mq.matches);
    const fn = () => setReducedMotion(mq.matches);
    mq.addEventListener('change', fn);
    return () => mq.removeEventListener('change', fn);
  }, []);

  const dots: Dot[] = useMemo(() => buildDotGrid(), []);

  useEffect(() => {
    if (reducedMotion || paused) return;
    const id = setInterval(() => {
      setHighlightIdx((i) => (i + 1) % EVENTS.length);
    }, STEP_MS);
    return () => clearInterval(id);
  }, [reducedMotion, paused]);

  // Main draw loop
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = STAGE * dpr;
    canvas.height = STAGE * dpr;
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    ctx.scale(dpr, dpr);

    let raf = 0;
    let lastT = performance.now();
    let lastLabelSync = 0;

    const draw = (t: number) => {
      const dt = Math.min(0.05, (t - lastT) / 1000);
      lastT = t;

      // Read current longitude from the shared state ref so drag handlers
      // can write to it between frames.
      let lng = stateRef.current.lng;

      if (stateRef.current.dragging) {
        // User is actively dragging — don't apply ambient spin or target pull.
        // The pointer-move handler already wrote the new lng into the ref.
      } else {
        // Otherwise: ambient spin + soft pull toward highlighted event.
        const e = EVENTS[stateRef.current.highlightIdx];
        const targetLng = wrap360(-e.lng);
        const diff = shortestAngle(targetLng - lng);

        const AMBIENT = stateRef.current.paused ? 3 : 9;
        const PULL_PER_SEC = 0.6;
        const pull = diff * Math.min(1, dt * PULL_PER_SEC);

        lng = wrap360(lng + AMBIENT * dt + pull);
      }

      stateRef.current.lng = lng;

      // ── DRAW ──
      ctx.clearRect(0, 0, STAGE, STAGE);

      // Halo
      const halo = ctx.createRadialGradient(CX, CY, GLOBE_R, CX, CY, GLOBE_R + 30);
      halo.addColorStop(0, 'rgba(242,180,199,0)');
      halo.addColorStop(0.55, 'rgba(242,180,199,0.50)');
      halo.addColorStop(1, 'rgba(242,180,199,0)');
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(CX, CY, GLOBE_R + 30, 0, Math.PI * 2);
      ctx.fill();

      // Sphere with off-center shading
      const sphereGrad = ctx.createRadialGradient(
        CX - GLOBE_R * 0.3, CY - GLOBE_R * 0.3, GLOBE_R * 0.2,
        CX, CY, GLOBE_R,
      );
      sphereGrad.addColorStop(0, 'rgba(253,237,242,0.75)');
      sphereGrad.addColorStop(0.7, 'rgba(252,228,236,0.50)');
      sphereGrad.addColorStop(1, 'rgba(248,207,220,0.25)');
      ctx.fillStyle = sphereGrad;
      ctx.beginPath();
      ctx.arc(CX, CY, GLOBE_R, 0, Math.PI * 2);
      ctx.fill();

      // Water dots
      for (let i = 0; i < dots.length; i++) {
        const d = dots[i];
        if (d.isLand) continue;
        const p = project(d.lat, d.lng + lng);
        if (p.z < -0.02) continue;
        const depthFade = 0.35 + p.z * 0.65;
        ctx.fillStyle = `rgba(232,170,190,${0.28 * depthFade})`;
        ctx.fillRect(CX + p.x - 0.5, CY + p.y - 0.5, 1.2, 1.2);
      }
      // Land dots
      for (let i = 0; i < dots.length; i++) {
        const d = dots[i];
        if (!d.isLand) continue;
        const p = project(d.lat, d.lng + lng);
        if (p.z < -0.02) continue;
        const depthFade = 0.45 + p.z * 0.55;
        ctx.fillStyle = `rgba(212,92,139,${0.92 * depthFade})`;
        ctx.fillRect(CX + p.x - 1.3, CY + p.y - 1.3, 2.6, 2.6);
      }

      // Pins
      const pulseT = (t / 1000) % 1.6 / 1.6;
      const activeIdx = stateRef.current.highlightIdx;
      const visibleSet = stateRef.current.visibleSet;
      const edgeSet = stateRef.current.edgeSet;
      const rawLabels: PinLabel[] = [];

      EVENTS.forEach((ev, idx) => {
        // Project at the CITY centroid so co-city events anchor together
        const anchor = CITY_LATLNG[idx];
        const p = project(anchor.lat, anchor.lng + lng);
        if (p.z < 0.08) return;
        const off = FAN_OFFSETS[idx];
        const cx = CX + p.x + off.dx;
        const cy = CY + p.y + off.dy;
        const depthFade = 0.55 + p.z * 0.45;
        const isActive = idx === activeIdx;
        const inList = visibleSet.has(idx);
        const isEdge = edgeSet.has(idx);

        if (isActive) {
          // Pulsing ring
          const ringR = 8 + pulseT * 28;
          ctx.strokeStyle = `rgba(212,92,139,${0.9 * (1 - pulseT)})`;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(cx, cy, ringR, 0, Math.PI * 2);
          ctx.stroke();

          const baseR = 18;
          const glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, baseR);
          glow.addColorStop(0,    `rgba(232,121,160,${0.95 * depthFade})`);
          glow.addColorStop(0.45, `rgba(242,180,199,${0.55 * depthFade})`);
          glow.addColorStop(0.85, `rgba(252,228,236,${0.20 * depthFade})`);
          glow.addColorStop(1,    'rgba(252,228,236,0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(cx, cy, baseR, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = `rgba(212,92,139,${depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 3.4, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = `rgba(255,255,255,${0.95 * depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 1.2, 0, Math.PI * 2);
          ctx.fill();
        } else if (inList) {
          const baseR = 12;
          const glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, baseR);
          glow.addColorStop(0,    `rgba(232,121,160,${0.85 * depthFade})`);
          glow.addColorStop(0.5,  `rgba(242,180,199,${0.40 * depthFade})`);
          glow.addColorStop(1,    'rgba(252,228,236,0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(cx, cy, baseR, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = `rgba(212,92,139,${0.95 * depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 2.6, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = `rgba(255,255,255,${0.9 * depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 1.0, 0, Math.PI * 2);
          ctx.fill();
        } else if (isEdge) {
          // Edge-preview pin — greyed, scroll hint only
          ctx.fillStyle = `rgba(140,120,128,${0.55 * depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 2.2, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = `rgba(255,255,255,${0.4 * depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 0.9, 0, Math.PI * 2);
          ctx.fill();
        } else {
          // Background pin — barely visible
          ctx.fillStyle = `rgba(180,150,160,${0.22 * depthFade})`;
          ctx.beginPath();
          ctx.arc(cx, cy, 1.4, 0, Math.PI * 2);
          ctx.fill();
        }

        if (isActive || inList) {
          rawLabels.push({
            idx,
            pinX: cx,
            pinY: cy,
            labelX: 0, // resolved below
            labelY: 0,
            side: cx > STAGE / 2 ? 'left' : 'right',
            z: p.z,
            tier: isActive ? 'active' : 'in-list',
            city: ev.city,
            name: ev.name,
          });
        }
      });

      // Group same-city labels into clusters, then lay them out vertically
      // per side. Each cluster card shows the city once with all event names
      // stacked underneath.
      const layout = buildClusters(rawLabels);

      if (t - lastLabelSync > 50) {
        lastLabelSync = t;
        setClusters(layout);
      }

      raf = requestAnimationFrame(draw);
    };

    raf = requestAnimationFrame(draw);
    return () => cancelAnimationFrame(raf);
  }, [dots]);

  const step = (dir: 1 | -1) => {
    setHighlightIdx((i) => (i + dir + EVENTS.length) % EVENTS.length);
  };

  const current = EVENTS[highlightIdx];

  return (
    <section
      id="globe"
      className="relative overflow-hidden"
      onPointerEnter={() => setPaused(true)}
      onPointerLeave={() => setPaused(false)}
    >
      {/* No solid background — the PageGarden bleeds through. A faint cream
          halo keeps the section's heart readable against the wallpaper. */}
      <div
        aria-hidden
        className="absolute inset-0 pointer-events-none"
        style={{
          background:
            'radial-gradient(ellipse 70% 80% at 50% 50%, rgba(251,246,241,0.6), transparent 75%)',
        }}
      />

      {/* Decorative ASCII flowers in the section corners */}
      <div className="absolute top-6 left-6 md:top-10 md:left-10 z-10 hidden md:block">
        <AsciiFlower variant="bloom" className="!text-rust-400/40" />
      </div>
      <div className="absolute top-6 right-6 md:top-10 md:right-10 z-10">
        <AsciiFlower variant="sprig" className="!text-rust-400/40" />
      </div>
      <div className="absolute bottom-8 left-10 md:bottom-12 md:left-20 z-10 hidden md:block">
        <AsciiFlower variant="daisy" className="!text-rust-400/35" />
      </div>

      <div className="relative z-10 max-w-[1200px] mx-auto px-6 md:px-12 py-8 md:py-12">
        {/* Top of section: now-showing ticker with prev/next, pinned to the
            top so people see what's playing right away. */}
        <div className="flex items-center justify-center gap-3 mb-8">
          <button
            type="button"
            aria-label="previous event"
            onClick={() => step(-1)}
            className="w-9 h-9 rounded-full bg-white/85 border border-rust-500/15 text-rust-700 hover:bg-rust-100 transition-colors flex items-center justify-center shadow-sm"
          >
            <ChevronLeft size={16} />
          </button>
          <div className="px-4 py-2 rounded-full bg-white/85 backdrop-blur-sm border border-rust-500/15 shadow-sm min-w-[300px] text-center">
            <AnimatePresence mode="wait">
              <motion.p
                key={current.id}
                initial={{ opacity: 0, y: 4 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -4 }}
                transition={{ duration: 0.35 }}
                className="font-mono text-[11px] tracking-[0.18em] text-warm-500"
              >
                <span className="text-rust-500">❀</span> now showing ·{' '}
                <span className="text-rust-700 font-semibold">{current.city.toLowerCase()}</span> ·{' '}
                <span className="text-ink-900">{current.name.toLowerCase()}</span>
              </motion.p>
            </AnimatePresence>
          </div>
          <button
            type="button"
            aria-label="next event"
            onClick={() => step(1)}
            className="w-9 h-9 rounded-full bg-white/85 border border-rust-500/15 text-rust-700 hover:bg-rust-100 transition-colors flex items-center justify-center shadow-sm"
          >
            <ChevronRight size={16} />
          </button>
        </div>

        {/* Compact analytics row */}
        <AnalyticsRow />

        <h2 className="mt-6 font-display-italic text-center text-rust-700 text-[40px] md:text-[60px] leading-[1.02] tracking-tight">
          built in cities <span className="text-sage-700">around the world.</span>
        </h2>

        <div className="mt-12 md:mt-16 grid md:grid-cols-[1.05fr_0.95fr] gap-2 md:gap-4 items-center">
          {/* LEFT: canvas globe + labels + leader lines */}
          <div className="relative w-full" style={{ aspectRatio: '1 / 1', maxWidth: 720 }}>
            <canvas
              ref={canvasRef}
              className="w-full h-full cursor-grab active:cursor-grabbing touch-none select-none"
              onPointerDown={(e) => {
                (e.target as Element).setPointerCapture?.(e.pointerId);
                dragStartRef.current = {
                  x: e.clientX,
                  startLng: stateRef.current.lng,
                };
                stateRef.current.dragging = true;
              }}
              onPointerMove={(e) => {
                const start = dragStartRef.current;
                if (!start || !stateRef.current.dragging) return;
                // Convert horizontal pixel delta to a longitude delta. Globe
                // diameter ~= canvas-width / 2 ⇒ width across the equator
                // corresponds to ~180°. We size by the actual rendered width.
                const w = (e.currentTarget as HTMLCanvasElement).getBoundingClientRect().width || 1;
                const dxPx = e.clientX - start.x;
                const dxDeg = (dxPx / w) * 360;
                stateRef.current.lng = wrap360(start.startLng + dxDeg);
              }}
              onPointerUp={() => {
                stateRef.current.dragging = false;
                dragStartRef.current = null;
              }}
              onPointerCancel={() => {
                stateRef.current.dragging = false;
                dragStartRef.current = null;
              }}
            />

            {/* SVG overlay for the leader lines (under the labels). For
                clusters, draw one dashed line from each pin to the cluster
                anchor so each event still has its own thread. */}
            <svg
              viewBox={`0 0 ${STAGE} ${STAGE}`}
              className="absolute inset-0 w-full h-full pointer-events-none"
              preserveAspectRatio="none"
              aria-hidden
            >
              {clusters.flatMap((c) =>
                c.items.map((l) => (
                  <line
                    key={`lead-${l.idx}`}
                    x1={l.pinX}
                    y1={l.pinY}
                    x2={c.labelX}
                    y2={c.labelY}
                    stroke={l.tier === 'active' ? 'rgba(166,64,106,0.65)' : 'rgba(212,92,139,0.4)'}
                    strokeWidth={l.tier === 'active' ? 1.0 : 0.7}
                    strokeDasharray="2 3"
                    opacity={0.5 + l.z * 0.5}
                  />
                )),
              )}

              {/* Airplane flight path — from the active pin to the right edge
                  of the canvas, where the EventTabBox sits next to. The
                  dashes flow along the path to create a moving "plane trail"
                  effect. */}
              {(() => {
                const active = clusters
                  .flatMap((c) => c.items)
                  .find((it) => it.tier === 'active');
                if (!active) return null;
                const startX = active.pinX;
                const startY = active.pinY;
                const endX = STAGE - 4;
                const endY = STAGE / 2;
                // Bend the curve outward so it arcs gracefully
                const ctrlX = (startX + endX) / 2 + 40;
                const ctrlY = Math.min(startY, endY) - 60;
                return (
                  <g>
                    <path
                      d={`M ${startX} ${startY} Q ${ctrlX} ${ctrlY}, ${endX} ${endY}`}
                      fill="none"
                      stroke="rgba(212,92,139,0.7)"
                      strokeWidth="1.6"
                      strokeDasharray="6 8"
                      strokeLinecap="round"
                      className="airplane-trail"
                    />
                    {/* Tiny airplane glyph at the end (anchor on the right) */}
                    <text x={endX - 4} y={endY + 4} fontSize="14" textAnchor="end" fill="rgba(166,64,106,0.85)">
                      ✈
                    </text>
                  </g>
                );
              })()}
            </svg>

            {/* Marching-dashes animation for the airplane trail */}
            <style jsx>{`
              :global(.airplane-trail) {
                animation: airplaneFlow 1.6s linear infinite;
              }
              @keyframes airplaneFlow {
                from { stroke-dashoffset: 0; }
                to   { stroke-dashoffset: -28; }
              }
              @media (prefers-reduced-motion: reduce) {
                :global(.airplane-trail) { animation: none; }
              }
            `}</style>

            {clusters.map((c) => (
              <ClusterLabel key={`cluster-${c.city}-${c.items[0].idx}`} c={c} />
            ))}
          </div>

          {/* RIGHT: tab-style scrollable event box */}
          <EventTabBox
            highlightIdx={highlightIdx}
            activeCity={current.city}
            onSelect={onSelect}
            onPick={(idx) => setHighlightIdx(idx)}
          />
        </div>

        {/* City pills — clicking a city jumps the globe to its first event */}
        <CityPills highlightIdx={highlightIdx} onJump={(idx) => setHighlightIdx(idx)} />
      </div>
    </section>
  );
}

/* ───────── Label layout — stack & de-overlap ───────── */

/**
 * Group same-city PinLabels into clusters, lay them out vertically per side
 * with de-overlap.
 *
 * One pin-per-city becomes a 1-line label ("CITY"); multi-pin cities become
 * a stacked card ("CITY" + one row per event).
 */
function buildClusters(raw: PinLabel[]): LabelCluster[] {
  // Group by city
  const groups = new Map<string, PinLabel[]>();
  raw.forEach((l) => {
    const arr = groups.get(l.city) ?? [];
    arr.push(l);
    groups.set(l.city, arr);
  });

  const LABEL_W_OFFSET = 26;
  // Approx height per row in the cluster card
  const ROW_H = 18;
  // Padding / header overhead
  const CARD_BASE_H = 28;

  const clusters: LabelCluster[] = [];
  groups.forEach((items, city) => {
    // Anchor is the average pin position of the cluster
    const anchorX = items.reduce((s, it) => s + it.pinX, 0) / items.length;
    const anchorY = items.reduce((s, it) => s + it.pinY, 0) / items.length;
    const side: 'left' | 'right' = anchorX > STAGE / 2 ? 'left' : 'right';
    const labelX = side === 'left' ? anchorX - LABEL_W_OFFSET : anchorX + LABEL_W_OFFSET;
    const z = items.reduce((s, it) => s + it.z, 0) / items.length;
    const hasActive = items.some((it) => it.tier === 'active');
    // Sort items so the active one shows first inside the card
    items.sort((a, b) => (a.tier === 'active' ? -1 : b.tier === 'active' ? 1 : 0));
    clusters.push({
      city,
      side,
      anchorX,
      anchorY,
      labelX,
      labelY: anchorY,
      items,
      z,
      hasActive,
    });
  });

  // De-overlap per side via simple 1D sweep based on each cluster's
  // estimated height.
  (['left', 'right'] as const).forEach((side) => {
    const onSide = clusters.filter((c) => c.side === side).sort((a, b) => a.labelY - b.labelY);
    for (let i = 1; i < onSide.length; i++) {
      const prev = onSide[i - 1];
      const curr = onSide[i];
      const prevH = CARD_BASE_H + prev.items.length * ROW_H;
      if (curr.labelY - prev.labelY < prevH) {
        curr.labelY = prev.labelY + prevH;
      }
    }
  });

  return clusters;
}

/* ───────── Cluster label ───────── */

function ClusterLabel({ c }: { c: LabelCluster }) {
  const leftPct = (c.labelX / STAGE) * 100;
  const topPct = (c.labelY / STAGE) * 100;
  const transform = c.side === 'left' ? 'translate(-100%, -50%)' : 'translate(0%, -50%)';

  return (
    <div
      className="absolute pointer-events-none transition-opacity duration-300"
      style={{
        left: `${leftPct}%`,
        top: `${topPct}%`,
        transform,
        opacity: 0.45 + c.z * 0.55,
      }}
    >
      <div
        className={`rounded-lg shadow-[0_8px_18px_-10px_rgba(166,64,106,0.5)] border whitespace-nowrap ${
          c.hasActive
            ? 'bg-white border-rust-500/30 px-3 py-2'
            : 'bg-white/85 backdrop-blur-sm border-rust-500/15 px-2.5 py-1.5'
        }`}
      >
        {/* City header — once */}
        <p
          className={`font-mono uppercase tracking-[0.14em] font-semibold leading-none ${
            c.hasActive ? 'text-[11px] text-rust-700' : 'text-[9.5px] text-rust-700/85'
          }`}
        >
          {c.city}
        </p>

        {/* Events under the header — only shown if at least one is active
            OR there are 2+ events (so we always disambiguate clusters). */}
        {(c.hasActive || c.items.length > 1) && (
          <ul className="mt-1.5 space-y-1">
            {c.items.map((item) => {
              const isActive = item.tier === 'active';
              return (
                <li
                  key={item.idx}
                  className={`flex items-center gap-1.5 leading-tight ${
                    isActive ? 'text-ink-900 font-medium' : 'text-ink-900/55'
                  }`}
                >
                  <span
                    className={`w-1 h-1 rounded-full shrink-0 ${
                      isActive ? 'bg-rust-500' : 'bg-rust-300/70'
                    }`}
                    aria-hidden
                  />
                  <span className={`${isActive ? 'text-[12px]' : 'text-[11px]'} max-w-[220px] truncate`}>
                    {item.name}
                  </span>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </div>
  );
}

/* ───────── Event tab box ───────── */

/**
 * Scrollable bordered box that lists ALL events.
 *  - Active row is highlighted with full opacity + white bg + border ring.
 *  - All other rows are dimmed (~50% opacity) so it's clear they're
 *    scrollable through, not the focus.
 *  - Clicking a row makes it active. Clicking the small chevron on a row
 *    opens the modal.
 *  - When `highlightIdx` changes (e.g. auto-cycle), we auto-scroll the
 *    active row into view smoothly.
 */
function EventTabBox({
  highlightIdx,
  activeCity,
  onSelect,
  onPick,
}: {
  highlightIdx: number;
  activeCity: string;
  onSelect: (e: EventItem) => void;
  onPick: (idx: number) => void;
}) {
  const scrollRef = useRef<HTMLDivElement | null>(null);
  const itemRefs = useRef<Array<HTMLButtonElement | null>>([]);

  // Keep the active row in view
  useEffect(() => {
    const el = itemRefs.current[highlightIdx];
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
  }, [highlightIdx]);

  // Count events in the active city for the header
  const cityCount = EVENTS.filter((e) => e.city === activeCity).length;

  return (
    <div className="relative">
      {/* Box frame */}
      <div className="relative rounded-2xl border border-rust-500/15 bg-white/55 backdrop-blur-sm shadow-[0_18px_42px_-22px_rgba(166,64,106,0.25)] overflow-hidden">
        {/* Header */}
        <div className="flex items-center justify-between px-4 py-2.5 border-b border-rust-500/10 bg-cream-100/60">
          <p className="font-mono text-[10px] uppercase tracking-[0.18em] text-rust-700">
            <span className="text-rust-500">❀</span> {activeCity.toLowerCase()} · {cityCount} event{cityCount > 1 ? 's' : ''}
          </p>
          <p className="font-mono text-[9.5px] uppercase tracking-[0.18em] text-warm-500/80">
            scroll ↕
          </p>
        </div>

        {/* Scroll body */}
        <div
          ref={scrollRef}
          className="relative max-h-[440px] md:max-h-[480px] overflow-y-auto scroll-smooth"
        >
          <ul className="p-2 space-y-1.5">
            {EVENTS.map((ev, idx) => {
              const isActive = idx === highlightIdx;
              const inActiveCity = ev.city === activeCity && !isActive;
              // Three tiers:
              //   active  — full opacity, white bg
              //   in-city — 78% opacity (sibling event in the same city)
              //   other   — 35% opacity
              const opacityClass = isActive
                ? 'opacity-100'
                : inActiveCity
                  ? 'opacity-80 hover:opacity-100'
                  : 'opacity-35 hover:opacity-70';
              return (
                <li key={ev.id}>
                  <button
                    ref={(el) => { itemRefs.current[idx] = el; }}
                    type="button"
                    onClick={() => onPick(idx)}
                    className={`group w-full text-left transition-all duration-300 ${opacityClass}`}
                  >
                    <CardRow event={ev} isActive={isActive} inCity={inActiveCity} onClick={() => onSelect(ev)} />
                  </button>
                </li>
              );
            })}
          </ul>
        </div>

        {/* Soft fade edges so the dimmed rows feel like they're "tucked away" */}
        <div className="pointer-events-none absolute inset-x-0 top-[40px] h-8 bg-gradient-to-b from-white/70 to-transparent" />
        <div className="pointer-events-none absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-white/70 to-transparent" />
      </div>
    </div>
  );
}

/* ───────── card row ───────── */

function CardRow({
  event,
  isActive,
  inCity = false,
  onClick,
}: {
  event: EventItem;
  isActive: boolean;
  inCity?: boolean;
  onClick: () => void;
}) {
  const tone: 'rose' | 'sage' = /offsite|summit|101|hunt|hq tour|class/i.test(event.name) ? 'sage' : 'rose';
  const month = new Date(event.startDate).toLocaleString('en-US', { month: 'short' });
  const year = new Date(event.startDate).getFullYear();
  const country = countryCode(event.country);
  const flyer = event.photos[0];

  return (
    <motion.div
      layout
      initial={{ opacity: 0, y: 16 }}
      animate={{ opacity: isActive ? 1 : 0.6, y: 0, scale: isActive ? 1 : 0.97 }}
      exit={{ opacity: 0, y: -16 }}
      transition={{ duration: 0.45, ease: [0.16, 1, 0.3, 1] }}
      onClick={onClick}
      className={`relative flex items-center gap-3 px-3 py-2.5 rounded-2xl text-left transition-colors w-full cursor-pointer ${
        isActive
          ? 'bg-white border border-rust-500/15 shadow-[0_14px_36px_-20px_rgba(166,64,106,0.35)]'
          : inCity
            ? 'bg-rust-100/40 border border-rust-300/30 hover:bg-rust-100/60'
            : 'bg-transparent hover:bg-white/40'
      }`}
    >
      <div
        className="w-14 h-14 rounded-lg shrink-0 relative overflow-hidden border border-rust-500/10"
        style={{
          background:
            tone === 'rose'
              ? 'radial-gradient(ellipse 70% 60% at 50% 60%, #E879A0 0%, #F2B4C7 40%, #FCE4EC 75%, #FFFFFF 100%)'
              : 'radial-gradient(ellipse 70% 60% at 50% 60%, #9BBDA8 0%, #BCD3C5 40%, #EEF5F0 75%, #FFFFFF 100%)',
        }}
      >
        {flyer ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img src={flyer} alt={event.name} className="w-full h-full object-cover" loading="lazy" />
        ) : (
          <span className="absolute inset-0 flex items-center justify-center text-white text-[14px]">
            {tone === 'rose' ? '✦' : '❁'}
          </span>
        )}
      </div>

      <div className="flex-1 min-w-0">
        <p className="font-mono text-[10px] uppercase tracking-[0.16em] text-sage-700/80">
          {event.city.toLowerCase()} <span className="text-warm-500/60 mx-1">·</span> {country}
        </p>
        <p
          className={`mt-0.5 leading-tight truncate ${
            isActive ? 'text-ink-900 text-[15px] font-semibold' : 'text-ink-900/70 text-[14px]'
          }`}
        >
          {event.name}
        </p>
        <p className="font-display-italic text-[12px] text-rust-700/85 leading-tight mt-0.5 truncate">
          {month} {year}
          {event.venue && (
            <>
              <span className="text-warm-500/60 mx-1">·</span>
              <span className="text-warm-500/80">{truncate(event.venue, 22)}</span>
            </>
          )}
        </p>
      </div>
    </motion.div>
  );
}

/* ───────── City pills ───────── */

/**
 * Replaces the old filter-pill row. Each unique city in the event list
 * becomes a clickable pill. Clicking a city jumps the globe to the first
 * event there (which lights it up + auto-glides into view).
 *
 * The active city's pill is highlighted to mirror the now-showing widget.
 */
function CityPills({
  highlightIdx,
  onJump,
}: {
  highlightIdx: number;
  onJump: (idx: number) => void;
}) {
  const activeCity = EVENTS[highlightIdx].city;

  // Build [{ city, firstIdx, count }] preserving event-order
  const seen = new Set<string>();
  const cities: { city: string; firstIdx: number; count: number }[] = [];
  EVENTS.forEach((e, i) => {
    if (seen.has(e.city)) {
      const found = cities.find((c) => c.city === e.city);
      if (found) found.count += 1;
      return;
    }
    seen.add(e.city);
    cities.push({ city: e.city, firstIdx: i, count: 1 });
  });
  // ensure counts are accurate
  cities.forEach((c) => {
    c.count = EVENTS.filter((e) => e.city === c.city).length;
  });

  return (
    <div className="mt-10 md:mt-12 flex flex-wrap items-center justify-center gap-2">
      {cities.map((c) => {
        const isActive = c.city === activeCity;
        return (
          <button
            key={c.city}
            type="button"
            onClick={() => onJump(c.firstIdx)}
            className={`group inline-flex items-center gap-1.5 text-[12px] px-3.5 py-1.5 rounded-full border transition-colors ${
              isActive
                ? 'bg-rust-500 text-white border-rust-500 shadow-[0_8px_18px_-10px_rgba(166,64,106,0.6)]'
                : 'bg-white/80 text-rust-700 border-rust-300/40 hover:bg-rust-100/80 hover:border-rust-400/60'
            }`}
          >
            <span
              className={`w-1.5 h-1.5 rounded-full ${
                isActive ? 'bg-cream-100' : 'bg-rust-400 group-hover:bg-rust-500'
              }`}
              aria-hidden
            />
            <span className="lowercase">{c.city}</span>
            <span className={`font-mono text-[9.5px] tracking-wider ${isActive ? 'text-cream-100/85' : 'text-rust-700/55'}`}>
              ·{c.count}
            </span>
          </button>
        );
      })}
    </div>
  );
}

function FilterPill({
  tone = 'warm',
  active = false,
  children,
}: {
  tone?: 'rose' | 'sage' | 'warm';
  active?: boolean;
  children: React.ReactNode;
}) {
  const base = 'text-[12px] px-3.5 py-1.5 rounded-full border';
  const styles = active
    ? tone === 'rose'
      ? 'bg-rust-100 text-rust-700 border-rust-200'
      : tone === 'sage'
      ? 'bg-sage-100 text-sage-700 border-sage-300/60'
      : 'bg-cream-200 text-warm-500 border-warm-300/60'
    : 'bg-cream-100 text-warm-500 border-warm-300/40';
  return <span className={`${base} ${styles}`}>{children}</span>;
}

/* ───────── helpers ───────── */

function buildDotGrid(): Dot[] {
  // Cover the full sphere from -88° to +88° so Antarctica + Arctic both
  // render (we previously stopped at ±82° which made the globe look "cut"
  // at the south pole).
  const out: Dot[] = [];
  for (let lat = -88; lat <= 88; lat += 2) {
    const circumference = Math.cos((lat * Math.PI) / 180);
    const steps = Math.max(8, Math.round(180 * circumference));
    for (let s = 0; s < steps; s++) {
      const lng = (s / steps) * 360 - 180;
      out.push({ lat, lng, isLand: isLand(lat, lng) });
    }
  }
  return out;
}

function project(latDeg: number, lngDeg: number) {
  const lat = (latDeg * Math.PI) / 180;
  const lng = (lngDeg * Math.PI) / 180;
  return {
    x: Math.cos(lat) * Math.sin(lng) * GLOBE_R,
    y: -Math.sin(lat) * GLOBE_R,
    z: Math.cos(lat) * Math.cos(lng),
  };
}

function wrap360(a: number) {
  let n = a % 360;
  if (n < 0) n += 360;
  return n;
}

function shortestAngle(deltaDeg: number) {
  let d = ((deltaDeg + 180) % 360) - 180;
  if (d < -180) d += 360;
  return d;
}

function truncate(s: string, n: number) {
  return s.length > n ? s.slice(0, n - 1) + '…' : s;
}

function countryCode(country: string): string {
  const map: Record<string, string> = {
    Singapore: 'SG',
    Thailand: 'TH',
    'United States': 'USA',
    Taiwan: 'TW',
    'Hong Kong': 'HK',
    'South Korea': 'KR',
    'United Arab Emirates': 'UAE',
    Italy: 'IT',
  };
  return map[country] ?? country.slice(0, 3).toUpperCase();
}

function citiesCount() {
  return new Set(EVENTS.map((e) => e.city)).size;
}

function yearsSpan() {
  const years = EVENTS.map((e) => new Date(e.startDate).getFullYear());
  return Math.max(...years) - Math.min(...years) + 1;
}
